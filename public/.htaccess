# Activa reescrituras
RewriteEngine On

# (Opcional) Forzar HTTPS
#RewriteCond %{HTTPS} !=on
#RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Sirve archivos y directorios reales (imágenes, css, js, fuentes, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback: envía todas las rutas a index.html
RewriteRule . /index.html [L]

########## CACHÉ ##########
# Assets con hash → cache larga
<FilesMatch "\.(?:js|mjs|css|png|jpg|jpeg|gif|svg|webp|ico|ttf|otf|woff|woff2)$">
  <IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 year"
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</FilesMatch>

# index.html → NO cache (para que se vean los deploys)
<Files "index.html">
  <IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 0 seconds"
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </IfModule>
</Files>

########## COMPRESIÓN ##########
# Gzip (fallback si no hay brotli)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Brotli (si está disponible en el hosting)
<IfModule mod_brotli.c>
  BrotliCompressionQuality 5
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

########## CORS fuentes ##########
<IfModule mod_headers.c>
  <FilesMatch "\.(ttf|otf|eot|woff|woff2)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

########## CABECERAS DE SEGURIDAD BÁSICAS ##########
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Ajusta CSP si lo necesitas; esta es permisiva para SPA básicas:
  # Header set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' https:; font-src 'self' https: data:"
  # Permissions-Policy ejemplo (ajústala a tu app):
  # Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
