# --------------------------------------------------------------------
# Base
# --------------------------------------------------------------------
RewriteEngine On
Options -Multiviews

# Si usas subcarpeta, ajusta RewriteBase (por ej. /app/)
RewriteBase /

# Preserva el header Authorization (útil para APIs)
SetEnvIf Authorization .+ HTTP_AUTHORIZATION=$0

# --------------------------------------------------------------------
# SPA routing: servir archivos reales y si no existen -> index.html
# Excluye rutas de API si conviven en el mismo host (ajusta ^api/ si tu prefijo es otro)
# --------------------------------------------------------------------
# 1) Si el recurso existe como archivo o directorio, no reescribir
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2) No tocar llamadas a API (ajusta el prefijo si es distinto)
RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteRule ^ - [L]

# 3) Todo lo demás va a index.html (SPA fallback)
RewriteRule ^ index.html [L]

# --------------------------------------------------------------------
# Compresión (Brotli / Deflate)
# --------------------------------------------------------------------
<IfModule mod_brotli.c>
  BrotliCompressionQuality 6
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

# --------------------------------------------------------------------
# Caché
#   - Assets fingerprinted (vite) pueden ser cacheados fuertemente
#   - index.html sin cache para que coja el último build
# --------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Caché larga para assets estáticos fingerprinted
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# Reglas extra por extensión
<FilesMatch "\.(js|css|png|jpe?g|webp|svg|ico|woff2?|mp4|map)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# No cachear el HTML principal
<FilesMatch "index\.html$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# --------------------------------------------------------------------
# Seguridad básica (ajusta según tu entorno)
# --------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Activa HSTS sólo si sirves SIEMPRE por HTTPS (y tras verificar)
  # Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains; preload"
</IfModule>

# --------------------------------------------------------------------
# CORS (opcional: descomenta si necesitas servir assets cross-origin)
# --------------------------------------------------------------------
# <IfModule mod_headers.c>
#   <FilesMatch "\.(js|css|svg|woff2?)$">
#     Header set Access-Control-Allow-Origin "*"
#   </FilesMatch>
# </IfModule>
